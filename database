CREATE TABLE public.circuits (
    id           SERIAL PRIMARY KEY,
    title        VARCHAR(200)  NOT NULL,
    subtitle     VARCHAR(300),
    description  TEXT,
    image_url    TEXT,
    price        NUMERIC(10,2) NOT NULL,
    old_price    NUMERIC(10,2),
    duration     INTEGER       NOT NULL,   -- days
    nights       INTEGER,
    region       VARCHAR(20)   DEFAULT 'nord' CHECK (region IN ('nord','sud')),
    departure    VARCHAR(100),
    spots        INTEGER       DEFAULT 20,
    rating       NUMERIC(3,1)  DEFAULT 5.0,
    reviews      INTEGER       DEFAULT 0,
    badge        VARCHAR(50),
    tag          VARCHAR(100),
    tag_color    VARCHAR(20)   DEFAULT 'teal',
    difficulty   VARCHAR(20)   DEFAULT 'Facile' CHECK (difficulty IN ('Facile','Modéré','Aventure')),
    group_size   VARCHAR(50),
    highlights   JSONB         DEFAULT '[]'::jsonb,
    programme    JSONB         DEFAULT '[]'::jsonb,
    inclus       JSONB         DEFAULT '[]'::jsonb,
    non_inclus   JSONB         DEFAULT '[]'::jsonb,
    is_active    BOOLEAN       DEFAULT true,
    created_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

