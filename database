--  TicTac Voyages — flight_reservations
--  À exécuter dans pgAdmin (Query Tool)
--  Supprime la table si elle existe déjà, puis la recrée.
-- ============================================================

DROP TABLE IF EXISTS public.flight_reservations CASCADE;

CREATE TABLE public.flight_reservations (
  id               SERIAL PRIMARY KEY,

  -- Relation utilisateur (optionnelle si réservation guest)
  user_id          INTEGER,

  -- Identifiants Duffel
  duffel_order_id  VARCHAR(100) UNIQUE,
  offer_id         VARCHAR(100),

  -- Infos vol (denormalisées pour affichage rapide)
  origin_iata      VARCHAR(3),
  destination_iata VARCHAR(3),
  airline_name     VARCHAR(100),
  flight_number    VARCHAR(20),
  departing_at     TIMESTAMPTZ,
  arriving_at      TIMESTAMPTZ,
  cabin_class      VARCHAR(30)  DEFAULT 'economy',

  -- Prix
  total_price      NUMERIC(10,2) NOT NULL DEFAULT 0,
  currency         VARCHAR(5)    NOT NULL DEFAULT 'TND',

  -- Passagers (JSON array)
  passengers       JSONB         NOT NULL DEFAULT '[]',

  -- Statuts
  status           VARCHAR(20)   NOT NULL DEFAULT 'pending'
    CHECK (status IN ('pending','confirmed','cancelled','completed')),
  payment_status   VARCHAR(20)   NOT NULL DEFAULT 'pending'
    CHECK (payment_status IN ('pending','paid','refunded')),
  payment_method   VARCHAR(20)   NOT NULL DEFAULT 'agency'
    CHECK (payment_method IN ('online','agency')),

  notes            TEXT,

  created_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW(),
  updated_at       TIMESTAMPTZ  NOT NULL DEFAULT NOW()
);

-- Index utiles
CREATE INDEX idx_flight_res_user    ON public.flight_reservations(user_id);
CREATE INDEX idx_flight_res_status  ON public.flight_reservations(status);
CREATE INDEX idx_flight_res_created ON public.flight_reservations(created_at DESC);

-- Trigger updated_at auto
CREATE OR REPLACE FUNCTION public.set_updated_at()
RETURNS TRIGGER LANGUAGE plpgsql AS $$
BEGIN NEW.updated_at = NOW(); RETURN NEW; END; $$;

DROP TRIGGER IF EXISTS trg_flight_res_updated ON public.flight_reservations;
CREATE TRIGGER trg_flight_res_updated
  BEFORE UPDATE ON public.flight_reservations
  FOR EACH ROW EXECUTE FUNCTION public.set_updated_at();

