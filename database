-- ─── TABLE: voyages_organises ────────────────────────────────────
CREATE TABLE public.voyages_organises (
    id           SERIAL PRIMARY KEY,
    title        VARCHAR(200)  NOT NULL,
    subtitle     VARCHAR(300),
    description  TEXT,
    image_url    TEXT,
    price        NUMERIC(10,2) NOT NULL,
    old_price    NUMERIC(10,2),
    duration     INTEGER       NOT NULL,        -- days
    departure    VARCHAR(100),                  -- "Tunis" or "15 Mars 2026"
    spots        INTEGER DEFAULT 30,
    rating       NUMERIC(3,1)  DEFAULT 5.0,
    reviews      INTEGER       DEFAULT 0,
    badge        VARCHAR(50),                   -- 'Populaire' | 'Nouveau' | 'Promo' | 'VIP'
    -- Filter fields (match VoyageCard/VoyagesOrganise.jsx expectations)
    pays         VARCHAR(100),
    destination  VARCHAR(200),
    continent    VARCHAR(50),                   -- 'europe' | 'asie' | 'afrique' | 'amerique' | 'ocean'
    saison       VARCHAR(30),                   -- 'ete' | 'hiver' | 'printemps' | 'automne' | 'toute-annee'
    budget       VARCHAR(20),                   -- 'economique' | 'standard' | 'premium' | 'luxe'
    categorie    VARCHAR(100),                  -- for simple filter buttons e.g. 'Famille' | 'Culture' | etc.
    -- Rich content
    programme    JSONB DEFAULT '[]'::jsonb,     -- array of strings (day by day)
    inclus       JSONB DEFAULT '[]'::jsonb,     -- array of strings
    non_inclus   JSONB DEFAULT '[]'::jsonb,     -- array of strings
    is_active    BOOLEAN DEFAULT true,
    created_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at   TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_vo_active    ON public.voyages_organises (is_active);
CREATE INDEX idx_vo_continent ON public.voyages_organises (continent);

-- ─── TABLE: voyage_reservations ──────────────────────────────────
CREATE TABLE public.voyage_reservations (
    id                 SERIAL PRIMARY KEY,
    voyage_id          INTEGER REFERENCES public.voyages_organises(id) ON DELETE SET NULL,
    first_name         VARCHAR(100) NOT NULL,
    last_name          VARCHAR(100) NOT NULL,
    email              VARCHAR(200) NOT NULL,
    phone              VARCHAR(30),
    chambre_type       VARCHAR(30)  DEFAULT 'double',
    number_of_persons  INTEGER      DEFAULT 1,
    total_price        NUMERIC(10,2),
    payment_method     VARCHAR(20)  DEFAULT 'agency'  CHECK (payment_method IN ('online','agency')),
    payment_status     VARCHAR(20)  DEFAULT 'pending' CHECK (payment_status IN ('pending','paid','refunded')),
    status             VARCHAR(20)  DEFAULT 'pending' CHECK (status IN ('pending','confirmed','cancelled','completed')),
    notes              TEXT,
    created_at         TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
    updated_at         TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

CREATE INDEX idx_vr_voyage_id ON public.voyage_reservations (voyage_id);
CREATE INDEX idx_vr_email     ON public.voyage_reservations (email);
CREATE INDEX idx_vr_status    ON public.voyage_reservations (status);

-- ─── TRIGGER: auto-update updated_at ─────────────────────────────
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN NEW.updated_at = NOW(); RETURN NEW; END;
$$ language 'plpgsql';

CREATE TRIGGER update_voyages_organises_updated_at
    BEFORE UPDATE ON public.voyages_organises
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

CREATE TRIGGER update_voyage_reservations_updated_at
    BEFORE UPDATE ON public.voyage_reservations
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();

